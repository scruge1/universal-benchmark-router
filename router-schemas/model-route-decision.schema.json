{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fold5:model-route-decision:v1",
  "title": "Auditable saved route decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "decided_at", "request_id", "request_sha256", "suite_sha256", "profile_set_sha256", "selected", "candidates", "outcome", "authority"],
  "properties": {
    "schema": {"const": "model-route-decision/v1"},
    "decision_id": {"type": "string", "pattern": "^decision-[0-9a-f]{24}$"},
    "decided_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "suite_sha256": {"$ref": "#/$defs/sha256"},
    "profile_set_sha256": {"$ref": "#/$defs/sha256"},
    "selected": {"type": ["object", "null"]},
    "candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "outcome": {"enum": ["selected", "no_eligible_route"]},
    "authority": {"const": {"scope": "saved_route_decision_only", "may_contact_endpoint": false, "may_mutate_services": false, "may_publish_route": false}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "$comment": "The selector emits ranked evidence and explicit exclusion reasons. It never mutates services or publishes routes."
}
