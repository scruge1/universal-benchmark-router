{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-router:task-intake-questionnaire:v1",
  "title": "Versioned plain-language task questionnaire",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "question_set_id", "version", "questions", "compiler", "authority"],
  "properties": {
    "schema": {"const": "task-intake-questionnaire/v1"},
    "question_set_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "compiler": {"type": "object"},
    "authority": {"const": {"scope": "offline_task_intake_questions_only", "may_infer_confirmation": false, "may_contact_endpoint": false}}
  }
}
