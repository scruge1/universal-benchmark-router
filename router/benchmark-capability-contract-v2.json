  ],
  "required_metrics": [
    "issued","completed","correct","failed","unsupported","pass_at_1","pass_at_k","all_trials_success","tool_precision","tool_recall","illegal_tool_calls","policy_violations","steps","retries","loops","context_compactions","resume_success","prompt_tokens","reasoning_tokens","output_tokens","ttft","tpot","end_to_end_latency","goodput","energy","peak_gpu_memory","peak_host_memory","thermal_events","xids","restoration_errors"
  ],
  "promotion_rules": [
    "performance_microbench_cannot_promote_quality_or_agent_capability",
    "long_context_correctness_cannot_promote_long_horizon_reliability",
    "raw_model_results_cannot_promote_a_harnessed_agent_claim",
    "harnessed_results_bind_the_exact_harness_system_prompt_tools_memory_compaction_and_retry_policy",
    "tool_capability_requires_executed_calls_and_environment_state_not_a_text_description",
    "objective_checkers_take_priority_over_model_judges",
    "every_route_claim_requires_an_applicable_lane_result_for_the_exact_configuration",
    "unsupported_is_recorded_and_not_scored_as_zero_or_omitted",
    "source_or_dataset_revision_drift_invalidates_comparability",
    "speed_and_quality_are_ranked_per_capability_never_as_one_global_model_rank"
  ],
  "execution_policy": {
    "screen_all_configs_through_tier": 2,
    "shortlist_before_tier": 3,
    "route_finalists_only_from_tier": 4,
    "service_envelope_only_after_capability_floor": true,
    "one_axis_change_per_comparison": true,
    "separate_prearm_and_live_authority_required": true
  },
  "authority": {"scope":"offline_capability_contract_only","may_execute_live":false,"may_publish_route":false}
}
