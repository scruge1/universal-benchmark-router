      "dimension":"terminal_work",
      "evidence_scope":"harnessed_agent_configuration",
      "tier":4,
      "benchmark_source_ids":["terminal-bench","tua-bench"],
      "required_subtests":["inspect","configure","build","debug","recover","verify","no_unrequested_mutation"],
