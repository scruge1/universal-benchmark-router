      "dimension":"long_context",
      "evidence_scope":"served_model_configuration",
      "tier":3,
      "benchmark_source_ids":["ruler"],
      "required_subtests":["4096","8192","16384","32768","multi_hop_tracing","aggregation","variable_tracking"],
