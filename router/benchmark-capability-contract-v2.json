      "required_subtests":["task_decomposition","dependency_order","safe_parallelism","handoff_context","conflicting_results","worker_failure_reassignment","duplicate_work_prevention","verifier_separation","final_synthesis_conservation"],
      "objective_checkers":["task_graph_conservation","artifact_hash_join","receipt_ownership","final_state_tests"],
