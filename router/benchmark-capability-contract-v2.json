  ],
  "evidence_scopes": [
    {"scope_id":"raw_model","meaning":"model response under an exact prompt and generation policy; no tools or harness loop"},
    {"scope_id":"served_model_configuration","meaning":"model plus exact quant, engine, context, sampling, placement, and server configuration"},
    {"scope_id":"harnessed_agent_configuration","meaning":"served configuration plus exact harness, system prompt, tools, policies, memory, compaction, and retry loop"}
  ],
  "tiers": [
    {"tier":0,"name":"identity_and_fit","purpose":"verify bytes, lineage, runtime, template, tokenizer, fit, restoration, and unsupported states"},
    {"tier":1,"name":"performance_screen","purpose":"cheap pp, tg, TTFT, TPOT, memory, energy, thermal, startup, and restoration screen"},
    {"tier":2,"name":"core_smoke","purpose":"cheap deterministic single-turn correctness and protocol compatibility"},
    {"tier":3,"name":"capability_qualification","purpose":"objective reasoning, coding, long-context, and function-call qualification for shortlisted configurations"},
    {"tier":4,"name":"agent_trajectory","purpose":"real tools, multi-turn recovery, repository and terminal work, long-horizon state, and resume reliability"},
    {"tier":5,"name":"service_envelope","purpose":"concurrency, sustained reliability, co-tenancy, power, topology, and failure recovery for route finalists"}
  ],
  "capability_lanes": [
    {
      "lane_id":"performance_microbench",
      "dimension":"performance",
      "evidence_scope":"served_model_configuration",
      "tier":1,
      "benchmark_source_ids":["local-campaign-plan"],
      "required_subtests":["pp512","tg128","startup","memory","energy","thermal","restoration"],
      "objective_checkers":["numeric_conservation","host_state_verifier"],
      "minimum_trials":3,
      "claim_cap":"performance_screen_only"
    },
    {
      "lane_id":"single_turn_core",
      "dimension":"single_turn_correctness",
      "evidence_scope":"raw_model",
      "tier":2,
      "benchmark_source_ids":["local-suite-v1"],
      "required_subtests":["instruction_following","structured_output","basic_reasoning","basic_math","single_function_coding"],
      "objective_checkers":["exact","schema","unit_test"],
      "minimum_trials":3,
      "claim_cap":"single_turn_smoke_only"
    },
    {
      "lane_id":"native_tool_calling",
      "dimension":"tool_calling",
      "evidence_scope":"served_model_configuration",
      "tier":3,
      "benchmark_source_ids":["bfcl-v4"],
      "required_subtests":["single_call","parallel_calls","multiple_calls","missing_tool","wrong_argument","format_sensitivity","tool_hallucination"],
      "objective_checkers":["ast_match","executable_call_match","illegal_call_count"],
      "minimum_trials":3,
      "claim_cap":"native_tool_protocol_qualification"
    },
    {
      "lane_id":"transactional_tool_agent",
