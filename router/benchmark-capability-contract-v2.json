      "dimension":"repository_coding",
      "evidence_scope":"harnessed_agent_configuration",
      "tier":4,
      "benchmark_source_ids":["swe-bench"],
      "required_subtests":["issue_localization","multi_file_patch","regression_tests","failed_test_recovery","clean_worktree_discipline"],
      "objective_checkers":["containerized_repository_tests","patch_scope_verifier"],
      "minimum_trials":3,
      "claim_cap":"exact_harness_repository_resolution_profile"
    },
    {
