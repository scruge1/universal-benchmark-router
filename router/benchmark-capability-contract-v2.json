      "tier":4,
      "benchmark_source_ids":["bfcl-v4","tau2-bench"],
      "required_subtests":["multi_turn","multi_step","timeout","rate_limit","malformed_result","permission_denied","partial_write","non_idempotent_guard","retry_budget","memory_recall","policy_compliance"],
      "objective_checkers":["environment_state","trajectory_policy","tool_argument_match","unsupported_success_rejection"],
      "minimum_trials":3,
      "claim_cap":"exact_harness_tool_agent_reliability"
    },
    {
      "lane_id":"advanced_reasoning",
      "dimension":"advanced_reasoning",
      "evidence_scope":"raw_model",
      "tier":3,
